# Local backend configuration. Set a private random value of at least 32 bytes.
APP_ENV=development
MARKETING_AUTH_SECRET=

# Comma-separated exact browser origins. Defaults to the two Vite localhost origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Point this at a persistent mounted volume in production.
# Local default is data/marketing.db; set a mounted path in production.
# MARKETING_DB_PATH=/var/lib/slimes-marketing/marketing.db

MARKETING_AI_ENABLED=false
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=20000

# Explicit Facebook publishing requires an approved Facebook draft. Use a Page
# access token for the target Page; Meta publishing requires pages_manage_posts,
# plus pages_manage_metadata/pages_manage_read_engagement/pages_show_list for
# discovery. Keep credentials server-side and never place them in VITE_* variables.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_BASE=https://graph.facebook.com/v26.0
FACEBOOK_PUBLISH_TIMEOUT_MS=20000
